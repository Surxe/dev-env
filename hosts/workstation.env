# Host profile: workstation (ethan-debian) — consumed by dev-env/install.sh.
# Sourced with `set -a`, so every assignment is exported for placeholder rendering.

# Claude project this box's dev memories live under (~dev/.claude/projects/-<PROJECT>).
PROJECT=srv-dev

# Space-separated shared items this box opts out of (skill dir / memory slug /
# bashrc fragment basename). Default empty = include every shared item.
EXCLUDE=""

# --- .local override values for parameterized shared items ---
# Where this box's BOX-LOCAL memory notes are source-controlled + the machine repo
# that owns them and how to deploy it (used by the shared edit-in-repo memory).
MACHINE_REPO=my-system
MEMORY_REPO_DIR=/srv/dev/repos/my-system/users/dev/memory/srv-dev
INSTALL_CMD=/srv/dev/repos/my-system/users/install.sh
